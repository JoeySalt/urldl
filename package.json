{
  "name": "urldl",
  "version": "0.1.0",
  "description": "Console app to download YouTube / X (Twitter) URLs as MP4 or MP3",
  "type": "module",
  "bin": {
    "urldl": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "setup": "pnpm install && pnpm build && ln -sf \"$PWD/dist/index.js\" \"$(pnpm bin -g)/urldl\" && echo \"Installed: run  urldl <url>\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.1.0",
    "ffmpeg-static": "^5.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
